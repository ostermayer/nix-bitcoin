#!/usr/bin/env nix-shell
#!nix-shell -i bash -p bash coreutils curl jq gnupg gnugrep
set -euo pipefail

scriptDir=$(cd "${BASH_SOURCE[0]%/*}" && pwd)

trap 'echo "Error at ${BASH_SOURCE[0]}:$LINENO"' ERR

repo=fort-nix/nix-bitcoin

# This legacy helper fetches an UPSTREAM (fort-nix) signed release tarball. This
# repository is a maintained FORK; upstream's release artifacts do NOT contain
# this fork's fixes, so fetching them here would silently ship un-fixed code.
# Consume this fork via its flake pin instead:
#   inputs.nix-bitcoin.url = "github:ostermayer/nix-bitcoin/release";
# Refuse to run unless explicitly overridden.
if [[ ! -v NIX_BITCOIN_FETCH_UPSTREAM ]]; then
    echo "This is a fork of nix-bitcoin; pin the flake, don't fetch releases:" >&2
    echo "  inputs.nix-bitcoin.url = \"github:ostermayer/nix-bitcoin/release\";" >&2
    echo "This helper fetches UPSTREAM ($repo) releases, WITHOUT the fork's fixes." >&2
    echo "Set NIX_BITCOIN_FETCH_UPSTREAM=1 only if you truly want upstream." >&2
    exit 1
fi

if [[ ! -v version ]]; then
    version=$(curl -fsS "https://api.github.com/repos/$repo/releases/latest" | jq -r '.tag_name' | tail -c +2)
fi

TMPDIR=$(mktemp -d)
trap 'rm -rf $TMPDIR' EXIT

export GNUPGHOME=$TMPDIR/gpg-home
mkdir -m 700 "$GNUPGHOME"

# Import key
gpg --import "$scriptDir/key-jonasnick.bin" &> /dev/null
# Check that exactly one key was imported
(($(gpg --list-keys --with-colons | grep -c pub) == 1))
# Verify key fingerprint
gpg --list-keys "36C7 1A37 C9D9 88BD E825 08D9 B1A7 0E4F 8DCD 0366" > /dev/null

# Fetch nar-hash of release
cd "$TMPDIR"
baseUrl=https://github.com/$repo/releases/download/v$version
curl -fsS -L -O "$baseUrl/nar-hash.txt"
curl -fsS -L -O "$baseUrl/nar-hash.txt.asc"

# Verify signature for nar-hash
gpg --verify nar-hash.txt.asc &> /dev/null || {
    >&2 echo "Error: Signature verification failed. Please open an issue in the project repository."
    exit 1
}

>&2 echo "Fetched and verified release $version"

cat <<EOF
builtins.fetchTarball {
  url = "https://github.com/$repo/archive/v$version.tar.gz";
  sha256 = "$(cat nar-hash.txt)";
}
EOF
